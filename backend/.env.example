# Port d'écoute de l'API (Render/Railway/Heroku injectent PORT automatiquement)
PORT=3000

# Origines autorisées pour CORS, séparées par des virgules.
# Laisser vide = autorise toutes les origines (pratique en dev).
# En production, mettre l'URL du frontend, ex :
# CORS_ORIGIN=https://edpulse-frontend.onrender.com
CORS_ORIGIN=
